# Optional. Copy to .env to override the defaults in docker-compose.yml.
# Docker Compose reads .env automatically for ${VAR:-default} substitution.

# PostgreSQL service (the official postgres image initialises the database from these)
POSTGRES_DB=dogapi
POSTGRES_USER=dogapi
POSTGRES_PASSWORD=dogapi

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
